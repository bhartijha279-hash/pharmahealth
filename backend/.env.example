# ===================================================
# PharmaHealth Backend Environment Variables (.env)
# ===================================================
PORT=8080
# Supabase -> Connect -> "Session pooler" (works over IPv4, e.g. from Render)
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=your_supabase_db_password
SPRING_JPA_HIBERNATE_DDL_AUTO=update
# Generate with: openssl rand -base64 64
JWT_SECRET=change_me
JWT_EXPIRATION=86400000
# Password for the built-in "admin" account (applied when the account is first created)
ADMIN_PASSWORD=change_me
# Comma-separated frontend origins allowed to call the API
ALLOWED_ORIGINS=https://your-app.vercel.app
# Create demo customers, orders and tickets (keep false in production)
SEED_DEMO_DATA=false
